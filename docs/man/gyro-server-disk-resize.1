.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-server-disk-resize - Grow an additional disk


.SH SYNOPSIS
\fBgyro server disk resize   [flags]\fP


.SH DESCRIPTION
Grow an additional disk

.PP
Grows the disk to \fBsize_gb\fR (never shrinks; not while snapshots exist). Extend the partition / file system inside the server afterwards.

.PP
API: PUT /cloud/servers/{id}/disks/{disk} (operationId resizeServerDisk, scope cloud_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for resize

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--size-gb\fP=0
	size_gb

.PP
\fB--wait\fP[=false]
	wait until the server is no longer busy

.PP
\fB--wait-timeout\fP=15m0s
	maximum time for --wait


