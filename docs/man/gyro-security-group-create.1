.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-security-group-create - Create a security group


.SH SYNOPSIS
\fBgyro security-group create [flags]\fP


.SH DESCRIPTION
Create a security group

.PP
Name unique per account (2-64 characters). Without \fBrules\fR the group has one outbound rule (all traffic) and no inbound rule.

.PP
API: POST /cloud/security-groups (operationId createSecurityGroup, scope cloud_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--description\fP=""
	description

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--name\fP=""
	name

.PP
\fB--rules\fP=[]
	rules

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


