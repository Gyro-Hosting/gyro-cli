.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-container-pipeline-create - Create a pipeline


.SH SYNOPSIS
\fBgyro container pipeline create  [flags]\fP


.SH DESCRIPTION
Create a pipeline

.PP
Connects a repository. The answer contains \fBwebhook_url\fR and (only here and in GET .../webhook) \fBwebhook_secret\fR: add both to the repository's webhook (GitHub: application/json + Secret, push event; GitLab: Secret token, push + tag push; Gitea: secret; other: X-Gyro-Signature HMAC). Optional \fBtoken\fR for a private repository.

.PP
API: POST /cloud/containers/{id}/pipelines (operationId pipeline_create, scope services_write)


.SH OPTIONS
\fB--approval\fP[=false]
	Wait for approval before deploying (24 h)

.PP
\fB--auto\fP[=false]
	Webhook pushes start runs

.PP
\fB--auto-rollback\fP[=false]
	Roll back when the new version is unhealthy

.PP
\fB--branch\fP=""
	Branches whose pushes build (comma separated globs, empty = none)

.PP
\fB--build-args\fP=""
	Dockerfile ARG values (visible in the image history) (JSON)

.PP
\fB--build-env\fP=""
	Variables for \fBcommands\fR (JSON)

.PP
\fB--build-image\fP=""
	Image that runs \fBcommands\fR (e.g. node:22-alpine)

.PP
\fB--build-target\fP=""
	Stage of a multi-stage Dockerfile to build (\fBFROM node:20 AS production\fR -> \fBproduction\fR, same as \fBdocker build --target\fR). Empty = the last stage. Stage names are case-insensitive (stored lowercase). A stage the Dockerfile does not have fails the run with \fBbuild_target_not_found\fR\&. gyro-pipeline.yml: \fBbuild_target:\fR overrides it per run. CLI: \fB--target\fR (or \fB--build-target\fR).

.PP
\fB--commands\fP=[]
	Shell commands run in the repository root before the Dockerfile (tests, npm ci ...); build secrets are environment variables here

.PP
\fB--context\fP=""
	Build folder (empty = repository root)

.PP
\fB--cpu-m\fP=0
	Build CPU (millicores, plan limit)

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dockerfile\fP=""
	dockerfile

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB--git-user\fP=""
	User name for the token (default: x-access-token / oauth2 / git)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--image\fP=""
	Image name in the environment registry (//: + :latest)

.PP
\fB--memory-mi\fP=0
	Build memory (MiB, plan limit)

.PP
\fB--name\fP=""
	Display name (1-48)

.PP
\fB--notify\fP=[]
	Notifications (channels: the environment's alert settings)

.PP
\fB--provider\fP=""
	provider (github|gitlab|gitea|git|archive)

.PP
\fB--repo\fP=""
	https clone URL (no credentials) or SSH address git@host:org/repo.git / ssh://user@host[:port]/path (needs a deploy key); empty for provider archive

.PP
\fB--repo-file\fP[=false]
	Read gyro-pipeline.yml from the repository (GitHub, GitLab, Gitea)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--tags\fP=""
	Tags that build (globs, e.g. v*)

.PP
\fB--targets\fP=[]
	Services that get the new image (empty = build only)

.PP
\fB--timeout-min\fP=0
	Build time limit (minutes, plan limit)

.PP
\fB--token\fP=""
	Read-only access token for a private repository (stored encrypted, never returned; "-" on update removes it)

.PP
\fB--verify-min\fP=0
	Health wait after deploy (1-30 minutes)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
