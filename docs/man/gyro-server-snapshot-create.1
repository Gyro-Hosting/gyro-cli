.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-server-snapshot-create - Take a snapshot


.SH SYNOPSIS
\fBgyro server snapshot create  [flags]\fP


.SH DESCRIPTION
Take a snapshot

.PP
\fBBilling (tr-ist-1, prepaid):\fP the first snapshot is free; every additional snapshot is its own hourly item and is billed \fBat least 1 hour\fP, even if it is deleted within minutes (the oldest snapshot counts as the free one).

.PP
API: POST /cloud/servers/{id}/snapshots (operationId createSnapshot, scope cloud_write)


.SH OPTIONS
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--wait\fP[=false]
	wait until the server is no longer busy

.PP
\fB--wait-timeout\fP=15m0s
	maximum time for --wait


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-server-snapshot(1)\fP
