.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-container-pipeline-run - Start a run


.SH SYNOPSIS
\fBgyro container pipeline run   [flags]\fP


.SH DESCRIPTION
Start a run

.PP
\fBref\fR: branch (\fBmain\fR), tag (\fBtag:v1.2.0\fR) or full ref; \fBsha\fR: optional 40 character commit. Without both the first branch of the rule builds. Queued runs start when the environment's parallel build limit allows. With \fBupload_id\fR the uploaded archive is built (gyro-pipeline.yml is not read for archives).

.PP
API: POST /cloud/containers/{id}/pipelines/{pipeline}/runs (operationId pipeline_run, scope services_write)


.SH OPTIONS
\fB--archive-name\fP=""
	Shown in the run list

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for run

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--ref\fP=""
	ref

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--sha\fP=""
	sha

.PP
\fB--upload-id\fP=""
	Build an uploaded archive (from POST .../uploads) instead of a git ref


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-container-pipeline(1)\fP
