.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-dns-acme-challenge-remove - Remove an ACME challenge TXT value


.SH SYNOPSIS
\fBgyro dns acme-challenge remove [flags]\fP


.SH DESCRIPTION
Remove an ACME challenge TXT value

.PP
Removes only \fBvalue\fR (query or JSON body); the record set is deleted when it becomes empty.

.PP
API: DELETE /cloud/dns/acme-challenge (operationId acmeChallengeRemove, scope dns_acme)


.SH OPTIONS
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for remove

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--name\fP=""
	_acme-challenge.

.PP
\fB--value\fP=""
	Challenge value (key authorization digest)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
