.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-sms-quote - Quote sms


.SH SYNOPSIS
\fBgyro sms quote [flags]\fP


.SH DESCRIPTION
Quote sms

.PP
Core WISECP client endpoint. Reference: https://dev.wisecp.com/tr/mesaj-gonderme

.PP
API: POST /sms/quote (operationId coreQuoteSms, scope Sms/QuoteSms)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for quote

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--message\fP=""
	Mesaj metni. Parça tavanını aşan metin kırpılır ve kırpıldığı bildirilir.

.PP
\fB--numbers\fP=[]
	Alıcı numaralar. Uluslararası biçimde; tek bir metin olarak gönderilirse satır, virgül ve noktalı virgülden bölünür.

.PP
\fB--sender\fP=""
	Gönderen başlığı. Hesabın etkin başlıklarından biri olmalıdır.

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-sms(1)\fP
