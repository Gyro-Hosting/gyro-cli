.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-s3-object-download-url - Presigned download URL


.SH SYNOPSIS
\fBgyro s3 object download-url   [flags]\fP


.SH DESCRIPTION
Presigned download URL

.PP
Returns a 15-minute GET URL (Content-Disposition: attachment). Downloads count toward the service's monthly traffic.

.PP
API: POST /cloud/storage/{id}/buckets/{bucket}/objects/download-url (operationId typed_post_storage\fBid\fPbuckets\fBbucket\fPobjects_download_url, scope services_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for download-url

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--key\fP=""
	Object key

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


