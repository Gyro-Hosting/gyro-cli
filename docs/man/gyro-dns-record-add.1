.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-dns-record-add - Create dns record


.SH SYNOPSIS
\fBgyro dns record add  [flags]\fP


.SH DESCRIPTION
Create dns record

.PP
Core WISECP client endpoint. Reference: https://dev.wisecp.com/tr/ad-sunuculari-ve-kayitlar

.PP
API: POST /domains/{domain}/dns-records (operationId coreCreateDnsRecord, scope Domains/CreateDnsRecord)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--identity\fP=""
	identity

.PP
\fB--name\fP=""
	Kaydın yanıtlayacağı ad. Kabul edilen biçim sağlayıcıya göre değişir.

.PP
\fB--priority\fP=0
	Öncelik. Posta ve hizmet kayıtları dışında yok sayılır.

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--ttl\fP=0
	Yaşam süresi. Verilmezse sağlayıcının varsayılanı kullanılır.

.PP
\fB--type\fP=""
	Kayıt türü.

.PP
\fB--value\fP=""
	Kaydın içeriği.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH EXAMPLE
.EX
  gyro dns record add example.com --type A --name www --value 203.0.113.10 --ttl 3600
.EE


.SH SEE ALSO
\fBgyro-dns-record(1)\fP
