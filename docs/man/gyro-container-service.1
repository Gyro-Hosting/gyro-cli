.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-container-service - List container services


.SH SYNOPSIS
\fBgyro container service [flags]\fP


.SH DESCRIPTION
List container services


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for service


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-container(1)\fP, \fBgyro-container-service-autoscale(1)\fP, \fBgyro-container-service-create(1)\fP, \fBgyro-container-service-delete(1)\fP, \fBgyro-container-service-get(1)\fP, \fBgyro-container-service-list(1)\fP, \fBgyro-container-service-restart(1)\fP, \fBgyro-container-service-revisions(1)\fP, \fBgyro-container-service-rollback(1)\fP, \fBgyro-container-service-scale(1)\fP, \fBgyro-container-service-update(1)\fP
