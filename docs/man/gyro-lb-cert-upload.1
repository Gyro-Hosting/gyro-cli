.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-cert-upload - Upload a certificate


.SH SYNOPSIS
\fBgyro lb cert upload  [flags]\fP


.SH DESCRIPTION
Upload a certificate

.PP
PEM certificate chain + unencrypted private key. The key is sent to the load balancer only; it is never stored or logged by the panel.

.PP
API: POST /cloud/load-balancers/{id}/certificates (operationId typed_post_load_balancers\fBid\fPcertificates, scope services_write)


.SH OPTIONS
\fB--certificate\fP=""
	PEM chain

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for upload

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--name\fP=""
	name

.PP
\fB--private-key\fP=""
	PEM key (unencrypted)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
