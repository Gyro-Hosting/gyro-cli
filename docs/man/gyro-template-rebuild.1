.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-template-rebuild - Reinstall a server from a template


.SH SYNOPSIS
\fBgyro template rebuild  [flags]\fP


.SH DESCRIPTION
Reinstall a server from a template

.PP
Overwrites the root disk of one of your tr-ist-1 servers with the template (its disk must be at least \fBmin_disk_gb\fR); the server's SSH keys are installed again and a new root password is returned (withheld when an Idempotency-Key is sent). Needs \fB"confirm": true\fR\&.

.PP
API: POST /cloud/templates/{id}/rebuild (operationId rebuildFromTemplate, scope cloud_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for rebuild

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--server-id\fP=0
	server_id

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--user-data\fP=""
	user_data


