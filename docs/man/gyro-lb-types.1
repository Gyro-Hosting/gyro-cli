.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-types - List load balancer sizes and prices


.SH SYNOPSIS
\fBgyro lb types [flags]\fP


.SH DESCRIPTION
List load balancer sizes and prices

.PP
Orderable sizes (small/medium/large) with limits, regions and EUR prices per cycle (excl. VAT); \fBlist_amount\fR is the strike-through list price.

.PP
API: GET /cloud/load-balancer-types (operationId listLoadBalancerTypes, scope cloud_read)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for types


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-lb(1)\fP
