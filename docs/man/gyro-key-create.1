.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-key-create - Create a sub-account key (token returned once)


.SH SYNOPSIS
\fBgyro key create [flags]\fP


.SH DESCRIPTION
Create a sub-account key (token returned once)

.PP
API: POST /cloud/keys (operationId createApiKey, scope keys)


.SH OPTIONS
\fB--actions\fP=[]
	Optional action allow list: server actions (reboot) or tool:action / tool:* / method:name

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB--expires\fP=""
	Key expiry: never (default), 7d, 30d, 90d, 1y, d (up to 1830) or a date YYYY-MM-DD (end of day). Expired keys are refused with 401 key_expired and revoked; the owner is mailed 7 days before.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--ips\fP=[]
	ips

.PP
\fB--name\fP=""
	name

.PP
\fB--rate-limit\fP=0
	Requests per minute (<= your own limit; 0 = default)

.PP
\fB--scopes\fP=[]
	scopes

.PP
\fB--services\fP=[]
	Optional service allow list

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--template\fP=""
	Ready-made scope set, added to scopes: readonly (cloud_read, services_read), dns (services_read, services_write, dns\fIacme), cloud (cloud\fP\fI, services_\fP), containers / storage (services_read, services_write, cloud_read), full (every delegable scope). (readonly|dns|cloud|containers|storage|full)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-key(1)\fP
