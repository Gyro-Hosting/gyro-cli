.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-firewall-set - Replace the network firewall policy


.SH SYNOPSIS
\fBgyro firewall set  [flags]\fP


.SH DESCRIPTION
Replace the network firewall policy

.PP
Applies as a 5 minute trial unless \fBpermanent\fR is true; confirm with POST /firewall/policy/confirm. Warnings return 422 \fBconfirm_warnings_required\fR with \fBdetails.warnings\fR\&.

.PP
API: PUT /cloud/servers/{id}/firewall/policy (operationId putFirewallPolicy, scope cloud_write)


.SH OPTIONS
\fB--confirm-warnings\fP[=false]
	confirm_warnings

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--default-action\fP=""
	default_action (allow|deny)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--permanent\fP[=false]
	Skip the 5 minute trial (otherwise call POST /firewall/policy/confirm within 5 minutes or the change is reverted)

.PP
\fB--ping\fP[=false]
	ping

.PP
\fB--rules\fP=[]
	rules

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--wait\fP[=false]
	wait until the server is no longer busy

.PP
\fB--wait-timeout\fP=15m0s
	maximum time for --wait


