.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-s3-folder-create - Create a folder


.SH SYNOPSIS
\fBgyro s3 folder create   [flags]\fP


.SH DESCRIPTION
Create a folder

.PP
Creates an empty folder marker \fBprefix + name + /\fR\&.

.PP
API: POST /cloud/storage/{id}/buckets/{bucket}/folders (operationId typed_post_storage\fBid\fPbuckets\fBbucket\fPfolders, scope services_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--name\fP=""
	name

.PP
\fB--prefix\fP=""
	prefix

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
