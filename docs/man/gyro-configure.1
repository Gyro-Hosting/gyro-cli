.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-configure - Store an API key and preferences in a named profile


.SH SYNOPSIS
\fBgyro configure [flags]\fP


.SH DESCRIPTION
Interactive setup, like 'aws configure'. Profiles live in ~/.config/gyro/config.toml (mode 0600).
Use --profile NAME for more than one account; --keyring keeps the key in the OS keychain instead of the file.
Non-interactive: echo "$KEY" | gyro configure --token-stdin --profile ci


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for configure

.PP
\fB--keyring\fP[=false]
	store the key in the OS keychain

.PP
\fB--no-verify\fP[=false]
	do not call /whoami to check the key

.PP
\fB--set-api-url\fP=""
	API URL to store in the profile

.PP
\fB--set-lang\fP=""
	language to store (tr/en)

.PP
\fB--set-output\fP=""
	default output to store

.PP
\fB--token-stdin\fP[=false]
	read the key from stdin (non-interactive)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro(1)\fP, \fBgyro-configure-delete(1)\fP, \fBgyro-configure-get(1)\fP, \fBgyro-configure-list(1)\fP, \fBgyro-configure-set(1)\fP
