.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-delete - Delete (cancel) a load balancer


.SH SYNOPSIS
\fBgyro lb delete  [flags]\fP


.SH DESCRIPTION
Delete (cancel) a load balancer

.PP
\fBconfirm=true\fR required. \fBimmediate=true\fR cancels now: traffic and billing stop, the load balancer and its certificates are deleted permanently at once. Without immediate a cancellation request is filed.

.PP
API: DELETE /cloud/load-balancers/{id} (operationId deleteLoadBalancer, scope cloud_delete)


.SH OPTIONS
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for delete

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--immediate\fP[=false]


