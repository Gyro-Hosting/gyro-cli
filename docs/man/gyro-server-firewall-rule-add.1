.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-server-firewall-rule-add - Add a firewall rule


.SH SYNOPSIS
\fBgyro server firewall rule add  [flags]\fP


.SH DESCRIPTION
Add a firewall rule

.PP
Network firewall add-on: inserts at \fBpriority\fR (default last) and applies as a trial unless \fBpermanent\fR\&. Otherwise the cloud server's simple inbound allow list.

.PP
API: POST /cloud/servers/{id}/firewall/rules (operationId addFirewallRule, scope cloud_write)


.SH OPTIONS
\fB--action\fP=""
	action (allow|deny)

.PP
\fB--confirm-warnings\fP[=false]
	Apply even when the change has warnings (lock-out risk, shadowed or duplicate rules, private sources)

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--description\fP=""
	description

.PP
\fB--destination\fP=""
	any (all IPs of the server) or one IP address of the server

.PP
\fB--direction\fP=""
	in = inbound to the server, out = new outbound connections (network firewall only) (in|out)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--permanent\fP[=false]
	Network firewall - skip the 5 minute trial and make the change permanent at once

.PP
\fB--port\fP=""
	any | 22 | 80,443 | 1000-2000 (not for icmp/all)

.PP
\fB--priority\fP=0
	Position (1 = evaluated first). Default = last. First matching rule wins.

.PP
\fB--protocol\fP=""
	protocol (tcp|udp|tcp_udp|icmp|all)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--source\fP=""
	any | IPv4/CIDR list (comma separated, max 10) | country:TR,DE | not-country:TR (country add-on; any ISO 3166-1 alpha-2 code with RIPE address space, max 10 per rule). For direction out: the remote address.

.PP
\fB--source-ips\fP=[]
	Legacy - CIDRs (use source)

.PP
\fB--wait\fP[=false]
	wait until the server is no longer busy

.PP
\fB--wait-timeout\fP=15m0s
	maximum time for --wait


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-server-firewall-rule(1)\fP
