.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-billing-statement - Monthly usage statement (not an invoice); --pdf / --csv to download


.SH SYNOPSIS
\fBgyro billing statement YYYY-MM [flags]\fP


.SH DESCRIPTION
Monthly usage statement (not an invoice); --pdf / --csv to download


.SH OPTIONS
\fB--csv\fP=""
	save as CSV (file, '.' = server name)

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for statement

.PP
\fB--pdf\fP=""
	save as PDF (file, '.' = server name)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH EXAMPLE
.EX
  gyro billing statement 2026-11
  gyro billing statement 2026-11 --pdf .
  gyro billing statement 2026-11 --csv kasim.csv
.EE


.SH SEE ALSO
\fBgyro-billing(1)\fP
