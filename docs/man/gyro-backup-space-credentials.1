.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-backup-space-credentials - SFTP connection with the password


.SH SYNOPSIS
\fBgyro backup-space credentials  [flags]\fP


.SH DESCRIPTION
SFTP connection with the password

.PP
Host, port, user, path and the SFTP password (\fBCache-Control: no-store\fR). Needs \fBservices_write\fR because it reveals a secret. 409 \fBnot_ready\fR while the space is being set up.

.PP
API: GET /cloud/backup-spaces/{id}/credentials (operationId getBackupSpaceCredentials, scope services_write)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for credentials


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--account\fP=""
	act in another account you are a panel user of (id from \fBgyro account list\fR; "self" = your own; env GYRO_ACCOUNT, profile default: \fBgyro account use\fR)

.PP
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-backup-space(1)\fP
