.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-create - Order a load balancer


.SH SYNOPSIS
\fBgyro lb create [flags]\fP


.SH DESCRIPTION
Order a load balancer

.PP
Orders and pays from the account balance (same money rules as servers): \fB"confirm": true\fR, an \fBIdempotency-Key\fR header, \fBdry_run\fR for a quote. Ready in about a minute; then add services and targets.

.PP
API: POST /cloud/load-balancers (operationId createLoadBalancer, scope cloud_order)


.SH OPTIONS
\fB--cycle\fP=""
	cycle

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB--end-customer-id\fP=0
	end_customer_id

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--product-id\fP=0
	product_id

.PP
\fB--project-id\fP=0
	Optional project for the new service(s) (0 = default project). Checked before the order: unknown id = 404 \fBproject_not_found\fR (GyroAPI order endpoints) or 422 \fBcheckout_blocked\fR with \fB[project_not_found]\fR (POST /orders).

.PP
\fB--region\fP=""
	region (eu-de-1|eu-de-2|eu-fi-1)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)

.PP
\fB--size\fP=""
	size (small|medium|large)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
