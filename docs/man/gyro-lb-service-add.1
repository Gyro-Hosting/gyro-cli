.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-service-add - Add a service


.SH SYNOPSIS
\fBgyro lb service add  [flags]\fP


.SH DESCRIPTION
Add a service

.PP
Adds a listener. HTTPS needs at least one certificate of this load balancer; TLS ends at the load balancer and targets get HTTP. Use TCP 443 for passthrough.

.PP
API: POST /cloud/load-balancers/{id}/services (operationId typed_post_load_balancers\fBid\fPservices, scope services_write)


.SH OPTIONS
\fB--certificates\fP=""
	HTTPS: comma separated certificate ids of this load balancer

.PP
\fB--cookie-lifetime\fP=0
	cookie_lifetime

.PP
\fB--cookie-name\fP=""
	cookie_name

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--destination-port\fP=0
	Port on the targets

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB--hc-domain\fP=""
	HTTP check Host header

.PP
\fB--hc-interval\fP=0
	3-60 s

.PP
\fB--hc-path\fP=""
	HTTP check path (starts with /)

.PP
\fB--hc-port\fP=0
	hc_port

.PP
\fB--hc-protocol\fP=""
	Health check type (tcp|http)

.PP
\fB--hc-retries\fP=0
	0-5

.PP
\fB--hc-status-codes\fP=""
	Comma separated, e.g. 2??,3??

.PP
\fB--hc-timeout\fP=0
	1-30 s, below interval

.PP
\fB--hc-tls\fP[=false]
	HTTP check over TLS

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for add

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--idle-timeout\fP=0
	Idle timeout (s)

.PP
\fB--listen-port\fP=0
