.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-ticket-list - List tickets


.SH SYNOPSIS
\fBgyro ticket list [flags]\fP


.SH DESCRIPTION
List tickets

.PP
List tickets. Support ticket of the calling account. Core WISECP client endpoint (Turkish reference: https://dev.wisecp.com/tr/destek-isteme).

.PP
API: GET /tickets (operationId coreGetTickets, scope Tickets/GetTickets)


.SH OPTIONS
\fB--all\fP[=false]
	fetch every page

.PP
\fB--department\fP=0
	Departman süzgeci.

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for list

.PP
\fB--limit\fP=0
	items per page (max 100)

.PP
\fB--page\fP=1
	page number

.PP
\fB--search\fP=""
	Konu, referans ve departman adında arar.

.PP
\fB--status\fP=""
	Durum süzgeci. Müşteriye gösterilen durum sözlüğünü kabul eder.


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-ticket(1)\fP
