.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-lb-network-detach - Detach from a private network


.SH SYNOPSIS
\fBgyro lb network detach   [flags]\fP


.SH DESCRIPTION
Detach from a private network

.PP
Targets that use private IPs must be removed first. Needs \fB"confirm": true\fR\&.

.PP
API: DELETE /cloud/load-balancers/{id}/network/{nid} (operationId typed_delete_load_balancers\fBid\fPnetwork__nid, scope services_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for detach

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
