.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-s3-lifecycle-noncurrent-set - Set old version expiry


.SH SYNOPSIS
\fBgyro s3 lifecycle noncurrent set   [flags]\fP


.SH DESCRIPTION
Set old version expiry

.PP
\fBdays\fR 1-3650, or 0 to keep old versions. Locked versions are deleted only after their retention ends. Other lifecycle rules of the bucket are kept.

.PP
API: PUT /cloud/storage/{id}/buckets/{bucket}/lifecycle/noncurrent (operationId setStorageNoncurrentExpiration, scope services_write)


.SH OPTIONS
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--days\fP=0
	days

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for set

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


