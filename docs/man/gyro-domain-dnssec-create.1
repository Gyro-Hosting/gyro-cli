.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-domain-dnssec-create - Create dnssec record


.SH SYNOPSIS
\fBgyro domain dnssec create  [flags]\fP


.SH DESCRIPTION
Create dnssec record

.PP
Core WISECP client endpoint. Reference: https://dev.wisecp.com/tr/ad-sunuculari-ve-kayitlar

.PP
API: POST /domains/{domain}/dnssec (operationId coreCreateDnssecRecord, scope Domains/CreateDnssecRecord)


.SH OPTIONS
\fB--algorithm\fP=0
	Anahtar algoritmasının numarası. Modülün bildirdiği kümede olmalıdır.

.PP
\fB--data\fP=""
	request body as JSON, @file or @- (stdin)

.PP
\fB--digest\fP=""
	İmza özeti. DNSKEY isteyen servis sağlayıcı burada açık anahtarı (base64) alır.

.PP
\fB--digest-type\fP=0
	Özet algoritmasının numarası ya da \fBmeta.dnssec_fields\fR\&'in adlandırdığı anahtar bayrağı veya protokol. Modülün bildirdiği kümede olmalıdır.

.PP
\fB--dry-run\fP[=false]
	show the price quote / request without changing anything

.PP
\fB-h\fP, \fB--help\fP[=false]
	help for create

.PP
\fB--idempotency-key\fP=""
	idempotency key (automatic for money operations)

.PP
\fB--key-tag\fP=0
	Anahtarın etiketi. \fBdnskey-keytag-flags\fR\&'te anahtar bayrağını taşır.

.PP
\fB--set\fP=[]
	extra body field key=value (repeatable)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


