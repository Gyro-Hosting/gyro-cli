.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-container-pipeline-list - List pipelines


.SH SYNOPSIS
\fBgyro container pipeline list  [flags]\fP


.SH DESCRIPTION
List pipelines

.PP
Pipelines of the environment with the last run, plan limits (\fBconcurrent\fR, \fBmonthly_minutes\fR, \fBmax_timeout\fR, \fBmax_cpu_m\fR, \fBmax_memory_mi\fR, \fBmax_pipelines\fR) and this month's build minutes.

.PP
API: GET /cloud/containers/{id}/pipelines (operationId pipeline_list, scope services_read)


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for list


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH SEE ALSO
\fBgyro-container-pipeline(1)\fP
