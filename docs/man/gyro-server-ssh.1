.nh
.TH "GYRO" "1" "Nov 2026" "Gyro Hosting" "gyro manual"

.SH NAME
gyro-server-ssh - Open an SSH session to a server


.SH SYNOPSIS
\fBgyro server ssh  [-- SSH-ARGS/COMMAND...] [flags]\fP


.SH DESCRIPTION
Looks up the server's IP and runs your local ssh client. Everything after "--" is passed to ssh,
so you can run a command remotely. Defaults come from the profile (ssh_user, ssh_identity).


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for ssh

.PP
\fB-i\fP, \fB--identity\fP=""
	private key file

.PP
\fB-6\fP, \fB--ipv6\fP[=false]
	connect over IPv6

.PP
\fB--port\fP=22
	SSH port

.PP
\fB-u\fP, \fB--user\fP=""
	remote user (default root)


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--api-url\fP=""
	API base URL (env GYRO_API_URL)

.PP
\fB--debug\fP[=false]
	log HTTP requests to stderr (secrets masked)

.PP
\fB--lang\fP=""
	message language: tr or en (default from locale)

.PP
\fB--no-color\fP[=false]
	disable colours (also NO_COLOR)

.PP
\fB--no-header\fP[=false]
	omit the table header

.PP
\fB-o\fP, \fB--output\fP=""
	output format: table, json, yaml, text

.PP
\fB-p\fP, \fB--profile\fP=""
	profile to use (env GYRO_PROFILE)

.PP
\fB--query\fP=""
	JMESPath query applied to the result

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	print only ids

.PP
\fB--timeout\fP=0s
	overall timeout, e.g. 30s, 10m

.PP
\fB--wide\fP[=false]
	show all table columns

.PP
\fB-y\fP, \fB--yes\fP[=false]
	do not ask for confirmation


.SH EXAMPLE
.EX
  gyro server ssh web-1
  gyro server ssh 47466 -i ~/.ssh/id_ed25519 -- uptime
  gyro server ssh web-1 --ipv6 -- -L 8080:localhost:80
.EE


.SH SEE ALSO
\fBgyro-server(1)\fP
